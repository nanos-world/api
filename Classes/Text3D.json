{
	"name": "Text3D",
	"description": "Class to create 3D Text with advanced options",
	"authority": "both",
	"network_distribution": "none",
	"inheritance": [
		"Entity",
		"Actor",
		"Paintable"
	],
	"constructors": [
		{
			"name": "Default Constructor",
			"parameters": [
				{
					"type": "Vector",
					"name": "location",
					"description": "World location to spawn at"
				},
				{
					"type": "Rotator",
					"name": "rotation",
					"description": "World rotation to spawn with"
				},
				{
					"type": "string",
					"name": "text",
					"description": "The text to display"
				},
				{
					"type": "Vector",
					"name": "scale",
					"default": "Vector(1, 1, 1)",
					"description": "Scale of the text"
				},
				{
					"type": "Color",
					"name": "color",
					"default": "Color(1, 1, 1, 1)",
					"description": "Color of the text"
				},
				{
					"type": "FontType",
					"name": "font_type",
					"default": "FontType.Roboto",
					"description": "Font to use"
				},
				{
					"type": "Text3DAlignCamera",
					"name": "align_camera",
					"default": "Text3DAlignCamera.Unaligned",
					"description": "Whether and how the text rotates to face the camera"
				}
			]
		}
	],
	"functions": [
		{
			"name": "SetFont",
			"authority": "both",
			"description": "Sets the Font",
			"parameters": [
				{
					"name": "font_type",
					"type": "FontType",
					"description": "The new Font"
				}
			],
			"efficiency": "fast"
		},
		{
			"name": "SetGlyphSettings",
			"authority": "both",
			"description": "Sets the Glyph representation settings to generate the 3D Mesh for this text render",
			"parameters": [
				{
					"type": "float",
					"name": "extrude",
					"default": "0",
					"description": "Depth of the 3D letters"
				},
				{
					"type": "float",
					"name": "level",
					"default": "0",
					"description": "Size of the bevel"
				},
				{
					"type": "Text3DBevelType",
					"name": "bevel_type",
					"default": "Text3DBevelType.Convex",
					"description": "Shape of the bevel"
				},
				{
					"type": "integer",
					"name": "bevel_segments",
					"default": "8",
					"description": "Number of segments of the bevel, more looks smoother"
				},
				{
					"type": "boolean",
					"name": "outline",
					"default": "false",
					"description": "Whether to only generate the outline of the letters"
				}
			],
			"efficiency": "fast"
		},
		{
			"name": "SetMaxSize",
			"authority": "both",
			"description": "Sets the Max Size of the Text3D, optionally scaling it proportionally",
			"parameters": [
				{
					"type": "integer",
					"name": "max_width",
					"default": "0",
					"description": "Max width of the text, 0 for no limit"
				},
				{
					"type": "integer",
					"name": "max_height",
					"default": "0",
					"description": "Max height of the text, 0 for no limit"
				},
				{
					"type": "boolean",
					"name": "scale_proportionally",
					"default": "true",
					"description": "Whether to keep the aspect ratio when scaling down"
				}
			],
			"efficiency": "fast"
		},
		{
			"name": "SetText",
			"authority": "both",
			"description": "Sets the Text",
			"parameters": [
				{
					"name": "text",
					"type": "string",
					"description": "The new Text"
				}
			],
			"efficiency": "moderate"
		},
		{
			"name": "SetTextSettings",
			"authority": "both",
			"description": "Sets the Text & Font settings for this text render",
			"parameters": [
				{
					"type": "float",
					"name": "kerning",
					"default": "0",
					"description": "Extra spacing between characters"
				},
				{
					"type": "float",
					"name": "line_spacing",
					"default": "0",
					"description": "Extra spacing between lines"
				},
				{
					"type": "float",
					"name": "word_spacing",
					"default": "0",
					"description": "Extra spacing between words"
				},
				{
					"type": "Text3DHorizontalAlignment",
					"name": "horizontal_alignment",
					"default": "Text3DHorizontalAlignment.Center",
					"description": "Horizontal alignment of the text"
				},
				{
					"type": "Text3DVerticalAlignment",
					"name": "vertical_alignment",
					"default": "Text3DVerticalAlignment.Center",
					"description": "Vertical alignment of the text"
				}
			],
			"efficiency": "fast"
		}
	]
}
