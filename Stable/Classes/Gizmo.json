{
	"name": "Gizmo",
	"description": "A tool to transform objects at runtime.",
	"authority": "client",
	"inheritance": [
		"Entity",
		"Actor"
	],
	"constructors": [
		{
			"name": "Default Constructor",
			"parameters": []
		}
	],
	"functions": [
		{
			"name": "Activate",
			"description": "Enables the interaction, placing the Gizmo at the given transform",
			"authority": "client",
			"parameters": [
				{
					"type": "Vector",
					"name": "location",
					"description": "World location of the Gizmo"
				},
				{
					"type": "Rotator",
					"name": "rotation",
					"description": "World rotation of the Gizmo"
				},
				{
					"type": "Vector",
					"name": "scale",
					"description": "Scale of the Gizmo"
				}
			],
			"efficiency": "moderate"
		},
		{
			"name": "Deactivate",
			"description": "Disable the interaction",
			"authority": "client",
			"efficiency": "moderate"
		},
		{
			"name": "IsInteracting",
			"authority": "client",
			"description": "Returns if it's currently interacting",
			"return": [
				{
					"type": "boolean",
					"name": "is_interacting",
					"description": "Whether it's currently interacting"
				}
			],
			"efficiency": "moderate"
		},
		{
			"name": "PressPointer",
			"authority": "client",
			"description": "Triggers the press pointer event on it",
			"efficiency": "moderate"
		},
		{
			"name": "ReleasePointer",
			"authority": "client",
			"description": "Triggers the release pointer event on it",
			"efficiency": "moderate"
		},
		{
			"name": "SetTransformMode",
			"authority": "client",
			"parameters": [
				{
					"type": "GizmoTransformMode",
					"name": "transform_mode",
					"description": "The transform mode"
				},
				{
					"type": "boolean",
					"name": "combine_translate_rotate",
					"description": "Whether to show the translation and rotation handles together"
				}
			],
			"efficiency": "moderate",
			"description": "Sets whether the Gizmo translates, rotates or scales"
		},
		{
			"name": "SetAlignSpace",
			"authority": "client",
			"parameters": [
				{
					"type": "GizmoAlignSpace",
					"name": "align_space",
					"description": "The align space"
				}
			],
			"efficiency": "moderate",
			"description": "Sets whether the Gizmo is aligned to the local or the world space"
		},
		{
			"name": "SetSnapSettings",
			"authority": "client",
			"parameters": [
				{
					"type": "float",
					"name": "location_grid_size",
					"description": "Translation snap size, in units"
				},
				{
					"type": "float",
					"name": "rotation_grid_size",
					"description": "Rotation snap size, in degrees"
				},
				{
					"type": "float",
					"name": "scale_grid_size",
					"description": "Scale snap size"
				}
			],
			"efficiency": "moderate",
			"description": "Sets the snapping grid sizes, 0 to disable snapping"
		}
	],
	"events": [
		{
			"name": "Transform",
			"authority": "client",
			"description": "Triggered when the Gizmo has its transform updated",
			"arguments": [
				{
					"name": "self",
					"type": "Gizmo",
					"description": "The Gizmo itself"
				},
				{
					"name": "location",
					"type": "Vector",
					"description": "New Gizmo location"
				},
				{
					"name": "rotation",
					"type": "Rotator",
					"description": "New Gizmo rotation"
				},
				{
					"name": "scale",
					"type": "Vector",
					"description": "New Gizmo scale"
				}
			]
		}
	]
}
