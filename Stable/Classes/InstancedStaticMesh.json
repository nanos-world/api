{
	"name": "InstancedStaticMesh",
	"description": "An Instanced Static Mesh entity allows spawning a mesh that can have multiple instances efficiently rendered.",
	"authority": "both",
	"network_distribution": "none",
	"inheritance": [
		"Entity",
		"Actor",
		"Paintable"
	],
	"constructors": [
		{
			"name": "Default Constructor",
			"parameters": [
				{
					"type": "Vector",
					"name": "location",
					"description": "World location to spawn at"
				},
				{
					"type": "Rotator",
					"name": "rotation",
					"description": "World rotation to spawn with"
				},
				{
					"type": "StaticMeshPath",
					"name": "static_mesh_asset",
					"description": "The Static Mesh asset to use"
				},
				{
					"type": "CollisionType",
					"name": "collision_type",
					"default": "CollisionType.Auto",
					"description": "Collision profile of this Actor"
				},
				{
					"type": "table",
					"name": "instances",
					"description": "Array with initial instances",
					"table_properties": [
						{
							"name": "Location",
							"type": "Vector",
							"description": "Relative location"
						},
						{
							"name": "Rotation",
							"type": "Rotator",
							"description": "Relative rotation (optional)"
						},
						{
							"name": "Scale",
							"type": "Vector",
							"description": "Relative scale (optional)"
						}
					],
					"default": "{}"
				},
				{
					"type": "SpawnMode",
					"name": "spawn_mode",
					"default": "SpawnMode.Immediate",
					"description": "Pass <code>SpawnMode.AfterConstructor</code> or <code>SpawnMode.Manual</code> to avoid immediately sending the entity to clients and improve performance when you want to configure it by setting several configs. Must call <code>FinishSpawn()</code> after all"
				}
			]
		}
	],
	"functions": [
		{
			"name": "GetMesh",
			"description": "Gets the Asset path mesh used",
			"return": [
				{
					"type": "StaticMeshPath",
					"name": "static_mesh_asset",
					"description": "Asset path mesh used"
				}
			],
			"authority": "both",
			"efficiency": "fast"
		},
		{
			"name": "AddInstance",
			"description": "Add an instance to this component",
			"parameters": [
				{
					"type": "Vector",
					"name": "relative_location",
					"description": "Location relative to this component"
				},
				{
					"type": "Rotator",
					"name": "relative_rotation",
					"default": "Rotator(0, 0, 0)",
					"description": "Rotation relative to this component"
				},
				{
					"type": "Vector",
					"name": "scale",
					"default": "Vector(1, 1, 1)",
					"description": "Scale of the instance"
				}
			],
			"return": [
				{
					"type": "integer",
					"name": "index",
					"description": "the index of the added instance"
				}
			],
			"authority": "authority",
			"efficiency": "moderate"
		},
		{
			"name": "AddInstances",
			"description": "Add multiple instances to this component. It is way efficient calling this once than AddInstance multiple times",
			"parameters": [
				{
					"type": "table",
					"name": "instances",
					"description": "Array with the instances",
					"table_properties": [
						{
							"name": "Location",
							"type": "Vector",
							"description": "Relative location"
						},
						{
							"name": "Rotation",
							"type": "Rotator",
							"description": "Relative rotation (optional)"
						},
						{
							"name": "Scale",
							"type": "Vector",
							"description": "Relative scale (optional)"
						}
					]
				}
			],
			"authority": "authority",
			"efficiency": "slow"
		},
		{
			"name": "RemoveInstance",
			"description": "Removes the instance at the given index. This will move the last element to the provided index, reducing the count by 1",
			"parameters": [
				{
					"type": "integer",
					"name": "index",
					"description": "Index of the instance"
				}
			],
			"authority": "authority",
			"efficiency": "moderate"
		},
		{
			"name": "SetInstanceTransform",
			"description": "Changes the transform of an existing instance. You can pass all other parameters as nil to modify only a single property",
			"parameters": [
				{
					"type": "integer",
					"name": "index",
					"description": "Index of the instance"
				},
				{
					"type": "Vector",
					"name": "relative_location",
					"default": "(current location)",
					"description": "Location relative to this component"
				},
				{
					"type": "Rotator",
					"name": "relative_rotation",
					"default": "(current rotation)",
					"description": "Rotation relative to this component"
				},
				{
					"type": "Vector",
					"name": "scale",
					"default": "(current scale)",
					"description": "Scale of the instance"
				}
			],
			"authority": "authority",
			"efficiency": "moderate"
		},
		{
			"name": "GetInstanceTransform",
			"description": "Returns the current transform of the instance at the given index",
			"parameters": [
				{
					"type": "integer",
					"name": "index",
					"description": "Index of the instance"
				}
			],
			"return": [
				{
					"type": "Vector",
					"name": "relative_location",
					"description": "The instance relative location"
				},
				{
					"type": "Rotator",
					"name": "relative_rotation",
					"description": "The instance relative rotation"
				},
				{
					"type": "Vector",
					"name": "scale",
					"description": "The instance scale"
				}
			],
			"authority": "both",
			"efficiency": "fast"
		},
		{
			"name": "GetInstanceCount",
			"description": "Returns the number of instances currently stored",
			"return": [
				{
					"type": "integer",
					"name": "count",
					"description": "Number of instances currently stored"
				}
			],
			"authority": "both",
			"efficiency": "fast"
		},
		{
			"name": "ClearInstances",
			"description": "Removes all instances.",
			"authority": "authority",
			"efficiency": "moderate"
		}
	]
}