{
	"name": "Billboard",
	"description": "A Billboard is a 2D Material that will be rendered always facing the camera.",
	"authority": "client",
	"inheritance": [
		"Entity",
		"Actor",
		"Paintable"
	],
	"constructors": [
		{
			"name": "Default Constructor",
			"parameters": [
				{
					"type": "Vector",
					"name": "location",
					"description": "World location to spawn at"
				},
				{
					"type": "MaterialPath",
					"name": "material_asset",
					"description": "The Material to render"
				},
				{
					"type": "Vector2D",
					"name": "size",
					"default": "Vector2D(32, 32)",
					"description": "Size in pixels"
				},
				{
					"type": "boolean",
					"name": "size_in_screen_space",
					"default": "false",
					"description": "Size is in Screen or World Space"
				}
			]
		}
	]
}